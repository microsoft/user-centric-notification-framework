<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- preserve GUID so you can reuse solution mapping if needed -->
    <ProjectGuid>55c14599-c0af-4f68-8b03-0a70a86308ab</ProjectGuid>
    <Authors>Infrastructure</Authors>
    <Description>Deployment project for LogicApp Email (ARM templates + scripts)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="LogicApp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LogicApp.parameters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Deploy-AzureResourceGroup.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- explicit Deploy target; uses the existing script. Consider migrating script to Az module or az cli. -->
  <Target Name="Deploy" DependsOnTargets="Build">
    <Message Text="Running deployment script: $(MSBuildProjectDirectory)\Deploy-AzureResourceGroup.ps1" Importance="High" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Deploy-AzureResourceGroup.ps1&quot; -ResourceGroupLocation &quot;eastus&quot;" />
  </Target>
</Project>